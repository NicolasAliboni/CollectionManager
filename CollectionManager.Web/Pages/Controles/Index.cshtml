@page
@model CollectionManager.Web.Pages.Controles.IndexModel

@{
    ViewData["Title"] = "Controles";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1>Controles</h1>
        <p class="page-subtitle">
            Visualize e gerencie os controles da sua coleção.
        </p>
    </div>

    <a asp-page="Create" class="btn btn-primary">
        + Adicionar Controle
    </a>
</div>

<div class="table-card">

    <div class="table-responsive">
        <table class="table collection-table align-middle">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Modelo</th>
                    <th>Estado</th>
                    <th>Marca</th>
                    <th>Plataforma</th>
                    <th>Franquia</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var controle in Model.Controles)
                {
                    <tr>
                        <td>
                            <strong>@controle.Item.Nome</strong>
                        </td>

                        <td>@controle.Modelo</td>

                        <td>
                            <span class="item-badge">
                                @controle.Item.Estado.Nome
                            </span>
                        </td>

                        <td>@controle.Marca.Nome</td>

                        <td>@controle.Plataforma.Nome</td>

                        <td>
                            @(controle.Item.Franquia?.Nome ?? "-")
                        </td>

                        <td class="text-end">
                            <a asp-page="Edit"
                               asp-route-id="@controle.ItemId"
                               class="btn btn-sm btn-outline-secondary">
                                Editar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>