@page
@model CollectionManager.Web.Pages.Estados.CreateModel

<h1>Adicionar Estado</h1>

<form method="post">
    <div class="mb-3">
        <label asp-for="Estado.Nome" class="form-label"></label>

        <input asp-for="Estado.Nome" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Salvar
    </button>

    <a asp-page="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>