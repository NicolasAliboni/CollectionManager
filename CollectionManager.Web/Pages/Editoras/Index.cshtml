@page
@model CollectionManager.Web.Pages.Editoras.IndexModel

@{
    ViewData["Title"] = "Editoras";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1>Editoras</h1>
        <p class="page-subtitle">
            Gerencie as editoras brasileiras e estrangeiras.
        </p>
    </div>

    <a asp-page="Create" class="btn btn-primary">
        + Adicionar Editora
    </a>
</div>

<div class="table-card">
    <div class="table-responsive">
        <table class="table collection-table align-middle">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Origem</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var editora in Model.Editoras)
                {
                    <tr>
                        <td>
                            <strong>@editora.Nome</strong>
                        </td>

                        <td>
                            <span class="item-badge">
                                @editora.Origem
                            </span>
                        </td>

                        <td class="text-end">
                            <a asp-page="Edit"
                               asp-route-id="@editora.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Editar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>