@page
@model CollectionManager.Web.Pages.Editoras.EditModel
@using CollectionManager.Web.ViewModels

<h1>Editar Editora</h1>

<form method="post">

    <input type="hidden" asp-for="Editora.Id" />

    <div class="mb-3">
        <label asp-for="Editora.Nome" class="form-label"></label>

        <input asp-for="Editora.Nome" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Editora.Origem" class="form-label"></label>

        <select asp-for="Editora.Origem"
                asp-items="Html.GetEnumSelectList<OrigemEditora>()"
                class="form-select">
        </select>
    </div>

    <button type="submit" class="btn btn-primary">
        Salvar
    </button>

    <a asp-page="Index" class="btn btn-secondary">
        Cancelar
    </a>

    <button type="submit"
            asp-page-handler="Delete"
            class="btn btn-danger">
        Excluir
    </button>

</form>