@page
@model CollectionManager.Web.Pages.Status.IndexModel

<h1>Status</h1>

<a asp-page="Create" class="btn btn-primary mb-3">
    Adicionar Status
</a>

<table class="table">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Tipo</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var status in Model.Status)
        {
            <tr>
                <td>@status.Nome</td>
                <td>@status.Tipo</td>
                <td>
                    <a asp-page="Edit"
                       asp-route-id="@status.Id"
                       class="btn btn-sm btn-secondary">
                        Editar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>