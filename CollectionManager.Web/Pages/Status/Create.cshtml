@page
@using CollectionManager.Web.ViewModels
@model CollectionManager.Web.Pages.Status.CreateModel

@{
    ViewData["Title"] = "Adicionar Status";
}

<div class="form-page-header">
    <a asp-page="Index" class="form-back-link">
        ← Voltar para Status
    </a>

    <h1>Adicionar Status</h1>

    <p class="form-page-subtitle">
        Cadastre um status para utilizar nas coleções.
    </p>
</div>

<form method="post" class="form-card form-card-small">

    <section class="form-section">
        <div class="form-section-title">
            Informações
        </div>

        <div class="form-grid">

            <div class="form-group">
                <label asp-for="Status.Nome" class="form-label">
                    Nome
                </label>

                <input asp-for="Status.Nome"
                       class="form-control"
                       placeholder="Ex.: Jogando" />
            </div>

            <div class="form-group">
                <label asp-for="Status.Tipo" class="form-label">
                    Tipo
                </label>

                <select asp-for="Status.Tipo"
                        asp-items="Html.GetEnumSelectList<TipoItem>()"
                        class="form-select">

                    <option value="">
                        Selecione um Tipo
                    </option>

                </select>
            </div>

        </div>
    </section>

    <div class="form-actions">
        <a asp-page="Index" class="btn btn-outline-secondary">
            Cancelar
        </a>

        <button type="submit" class="btn btn-primary">
            Salvar
        </button>
    </div>

</form>