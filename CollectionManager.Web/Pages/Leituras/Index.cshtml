@page
@model CollectionManager.Web.Pages.Leituras.IndexModel
@using CollectionManager.Web.ViewModels

@{
    ViewData["Title"] = "Leituras";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1>Leituras</h1>

        <p class="page-subtitle">
            Suas coleções de mangás, quadrinhos e livros.
        </p>
    </div>

    <a asp-page="CreateColecao" class="btn btn-primary">
        + Adicionar coleção
    </a>
</div>

@if (Model.Colecoes.Count == 0)
{
    <div class="table-card p-4">
        <h5>Nenhuma coleção cadastrada</h5>

        <p class="text-muted mb-0">
            Adicione uma coleção e cadastre os volumes dentro dela.
        </p>
    </div>
}
else
{
    <div class="collections-grid">
        @foreach (var colecao in Model.Colecoes)
        {
            var tipoTexto = colecao.Tipo switch
            {
                TipoLeitura.Manga => "Mangá",
                TipoLeitura.Quadrinho => "Quadrinho",
                TipoLeitura.Livro => "Livro",
                _ => "Leitura"
            };

            <a asp-page="Colecao"
               asp-route-id="@colecao.Id"
               class="collection-card collection-card-link">

                <div class="collection-card-icon" aria-hidden="true">
                    📚
                </div>

                <div class="collection-card-content">
                    <h2>@colecao.Nome</h2>

                    <p>@tipoTexto</p>

                    @if (!string.IsNullOrWhiteSpace(colecao.Autor))
                    {
                        <p>@colecao.Autor</p>
                    }

                    @if (colecao.VolumeAte > 0)
                    {
                        <p>
                            Total previsto:
                            @colecao.VolumeAte
                            @(colecao.VolumeAte == 1 ? "volume" : "volumes")
                        </p>
                    }

                    <span class="collection-card-action">
                        Ver coleção →
                    </span>
                </div>
            </a>
        }
    </div>
}