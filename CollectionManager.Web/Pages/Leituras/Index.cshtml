@page
@model CollectionManager.Web.Pages.Leituras.IndexModel

@{
    ViewData["Title"] = "Leituras";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1>Leituras</h1>
        <p class="page-subtitle">
            Visualize e gerencie seus mangás, quadrinhos e livros.
        </p>
    </div>

    <a asp-page="Create" class="btn btn-primary">
        + Adicionar Leitura
    </a>
</div>

<div class="table-card">
    <div class="table-responsive">
        <table class="table collection-table align-middle">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Franquia</th>
                    <th>Editora Brasil</th>
                    <th>Data Lançamento</th>
                    <th>Status</th>
                    <th>Estado</th>
                    <th>Volume</th>
                    <th>Volume Até</th>
                    <th>Valor</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var leitura in Model.Leituras)
                {
                    <tr>
                        <td>
                            <strong>@leitura.Item.Nome</strong>
                        </td>

                        <td>@(leitura.Item.Franquia?.Nome ?? "-")</td>

                        <td>@leitura.EditoraBrasil.Nome</td>

                        <td>@leitura.Item.DataLancamento.ToString("dd/MM/yyyy")</td>

                        <td>
                            <span class="item-badge">
                                @leitura.Status.Nome
                            </span>
                        </td>

                        <td>@leitura.Item.Estado.Nome</td>

                        <td>@leitura.Volume</td>

                        <td>@leitura.VolumeAte</td>

                        <td>
                            @(leitura.Item.ValorAquisicao.HasValue
                                ? leitura.Item.ValorAquisicao.Value.ToString("C")
                                : "-")
                        </td>

                        <td class="text-end">
                            <a asp-page="Edit"
                               asp-route-id="@leitura.ItemId"
                               class="btn btn-sm btn-outline-secondary">
                                Editar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>