@page
@model CollectionManager.Web.Pages.Leituras.IndexModel

@{
    ViewData["Title"] = "Leituras";
}

<div class="page-header d-flex justify-content-between align-items-center">

    <div>
        <h1>Leituras</h1>

        <p class="page-subtitle">
            Visualize suas coleções de mangás, quadrinhos e livros.
        </p>
    </div>

    <a asp-page="Create"
       class="btn btn-primary">
        + Adicionar Leitura
    </a>

</div>


@if (Model.Franquias.Count == 0)
{
    <div class="table-card p-4">

        <h5>Nenhuma leitura cadastrada</h5>

        <p class="text-muted mb-0">
            Adicione sua primeira leitura para começar sua coleção.
        </p>

    </div>
}
else
{
    <div class="collections-grid">

        @foreach (var franquia in Model.Franquias)
        {
            <a asp-page="Franquia"
               asp-route-id="@franquia.FranquiaId"
               class="collection-card collection-card-link">

                <div class="collection-card-icon">
                    📚
                </div>

                <div class="collection-card-content">

                    <h2>
                        @franquia.Nome
                    </h2>

                    @if (franquia.FranquiaId.HasValue)
                    {
                        <p>
                            @franquia.QuantidadeVolumes / @franquia.VolumeAte volumes
                        </p>

                        @if (franquia.QuantidadeVolumes >= franquia.VolumeAte)
                        {
                            <span class="collection-status collection-status-complete">
                                Coleção completa
                            </span>
                        }
                        else
                        {
                            var faltam = franquia.VolumeAte - franquia.QuantidadeVolumes;

                            <span class="collection-status">
                                Faltam @faltam volume@(faltam == 1 ? "" : "s")
                            </span>
                        }
                    }
                    else
                    {
                        <p>
                            @franquia.QuantidadeVolumes
                            @(franquia.QuantidadeVolumes == 1 ? "item" : "itens")
                        </p>
                    }

                    <span class="collection-card-action">
                        Ver coleção →
                    </span>

                </div>

            </a>
        }

    </div>
}