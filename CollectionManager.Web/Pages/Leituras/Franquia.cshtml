@page
@model CollectionManager.Web.Pages.Leituras.FranquiaModel

@{
    ViewData["Title"] = Model.NomeFranquia;
}

<div class="page-header d-flex justify-content-between align-items-center">

    <div>

        <a asp-page="Index"
           class="form-back-link">
            ← Voltar para Leituras
        </a>

        <h1>@Model.NomeFranquia</h1>

        @if (Model.FranquiaId.HasValue)
        {
            <p class="page-subtitle">
                @Model.QuantidadeVolumes / @Model.VolumeAte volumes cadastrados
            </p>
        }
        else
        {
            <p class="page-subtitle">
                @Model.QuantidadeVolumes
                @(Model.QuantidadeVolumes == 1 ? "item cadastrado" : "itens cadastrados")
            </p>
        }

    </div>

    <a asp-page="Create"
       class="btn btn-primary">
        + Adicionar Leitura
    </a>

</div>


@if (Model.Leituras.Count == 0)
{
    <div class="table-card p-4">

        <h5>Nenhum item encontrado</h5>

        <p class="text-muted mb-0">
            Não existem leituras cadastradas nesta coleção.
        </p>

    </div>
}
else
{
    <div class="table-card">

        <div class="table-responsive">

            <table class="table collection-table align-middle">

                <thead>
                    <tr>
                        <th>Volume</th>
                        <th>Nome</th>
                        <th>Editora Brasil</th>
                        <th>Data Lançamento</th>
                        <th>Status</th>
                        <th>Estado</th>
                        <th>Valor</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var leitura in Model.Leituras)
                    {
                        <tr>

                            <td>
                                <strong>@leitura.Volume</strong>
                            </td>

                            <td>
                                @leitura.Item.Nome
                            </td>

                            <td>
                                @leitura.EditoraBrasil.Nome
                            </td>

                            <td>
                                @leitura.Item.DataLancamento.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                <span class="item-badge">
                                    @leitura.Status.Nome
                                </span>
                            </td>

                            <td>
                                @leitura.Item.Estado.Nome
                            </td>

                            <td>
                                @(leitura.Item.ValorAquisicao.HasValue
                                    ? leitura.Item.ValorAquisicao.Value.ToString("C")
                                    : "-")
                            </td>

                            <td class="text-end">

                                <a asp-page="Edit"
                                   asp-route-id="@leitura.ItemId"
                                   class="btn btn-sm btn-outline-secondary">
                                    Editar
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}