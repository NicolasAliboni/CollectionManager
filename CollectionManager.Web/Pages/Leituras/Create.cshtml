@page
@model CollectionManager.Web.Pages.Leituras.CreateModel

@{
    ViewData["Title"] = "Adicionar volume";
}

<div class="form-page-header">
    <a asp-page="Colecao"
       asp-route-id="@Model.Leitura.ColecaoLeituraId"
       class="form-back-link">
        ← Voltar para a coleção
    </a>

    <h1>Adicionar volume</h1>

    <p class="form-page-subtitle">
        Preencha as informações específicas deste volume.
    </p>
</div>

<form method="post"
      asp-route-colecaoLeituraId="@Model.Leitura.ColecaoLeituraId"
      class="form-card">

    <div asp-validation-summary="All"
         class="text-danger"
         role="alert"></div>

    <input type="hidden" asp-for="Leitura.ColecaoLeituraId" />

    <section class="form-section">
        <div class="form-section-title">
            Informações do volume
        </div>

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="Leitura.Volume" class="form-label">
                    Volume
                </label>

                <input asp-for="Leitura.Volume" onfocus="this.select()"
                       type="number"
                       min="0"
                       step="any"
                       class="form-control"
                       required />
            </div>

            <div class="form-group">
                <label asp-for="Leitura.Titulo" class="form-label">
                    Título específico
                </label>

                <input asp-for="Leitura.Titulo"
                       class="form-control"
                       placeholder="Opcional" />
            </div>

            <div class="form-group">
                <label asp-for="Leitura.DataLancamento"
                       class="form-label">
                    Data de lançamento
                </label>

                <input asp-for="Leitura.DataLancamento"
                       type="date"
                       class="form-control"
                       required />
            </div>

            <div class="form-group">
                <label asp-for="Leitura.Status" class="form-label">
                    Status de leitura
                </label>

                <select asp-for="Leitura.Status"
                        class="form-select"
                        required>
                    <option value="1">A ler</option>
                    <option value="2">Lendo</option>
                    <option value="3">Lido</option>
                </select>
            </div>

            <div class="form-group">
                <label asp-for="Leitura.EstadoId" class="form-label">
                    Estado de conservação
                </label>

                <select asp-for="Leitura.EstadoId"
                        class="form-select"
                        required>
                    <option value="">Selecione um estado</option>

                    @foreach (var estado in Model.Estados)
                    {
                        <option value="@estado.Id">
                            @estado.Nome
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label asp-for="Leitura.ISBN13" class="form-label">
                    ISBN-13
                </label>

                <input asp-for="Leitura.ISBN13"
                       class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Leitura.CodigoEAN" class="form-label">
                    Código EAN
                </label>

                <input asp-for="Leitura.CodigoEAN"
                       class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Leitura.DataAquisicao"
                       class="form-label">
                    Data de aquisição
                </label>

                <input asp-for="Leitura.DataAquisicao"
                       type="date"
                       class="form-control"
                       required />
            </div>

            <div class="form-group">
                <label asp-for="Leitura.ValorAquisicao"
                       class="form-label">
                    Valor de aquisição
                </label>

                <input asp-for="Leitura.ValorAquisicao"
                       type="number"
                       min="0"
                       step="0.01"
                       class="form-control"
                       placeholder="0,00" />
            </div>

            <div class="form-group form-group-full">
                <label asp-for="Leitura.Observacoes"
                       class="form-label">
                    Observações
                </label>

                <textarea asp-for="Leitura.Observacoes"
                          class="form-control"
                          rows="4"
                          placeholder="Particularidades deste exemplar"></textarea>
            </div>
        </div>
    </section>

    <div class="form-actions">
        <a asp-page="Colecao"
           asp-route-id="@Model.Leitura.ColecaoLeituraId"
           class="btn btn-outline-secondary">
            Cancelar
        </a>

        <button type="submit" class="btn btn-primary">
            Salvar volume
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}