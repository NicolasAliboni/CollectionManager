@page
@model CollectionManager.Web.Pages.Marcas.EditModel

<h1>Editar Marca</h1>

<form method="post">

    <input type="hidden" asp-for="Marca.Id" />

    <div class="mb-3">
        <label asp-for="Marca.Nome" class="form-label"></label>

        <input asp-for="Marca.Nome" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Salvar
    </button>

    <a asp-page="Index" class="btn btn-secondary">
        Cancelar
    </a>

    <button type="submit"
            asp-page-handler="Delete"
            class="btn btn-danger">
        Excluir
    </button>

</form>