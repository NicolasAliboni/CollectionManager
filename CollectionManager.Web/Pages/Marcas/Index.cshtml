@page
@model CollectionManager.Web.Pages.Marcas.IndexModel

<h1>Marcas</h1>

<a asp-page="Create" class="btn btn-primary mb-3">
    Adicionar Marca
</a>

<table class="table">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var marca in Model.Marcas)
        {
            <tr>
                <td>@marca.Nome</td>
                <td>
                    <a asp-page="Edit"
                       asp-route-id="@marca.Id"
                       class="btn btn-sm btn-secondary">
                        Editar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>