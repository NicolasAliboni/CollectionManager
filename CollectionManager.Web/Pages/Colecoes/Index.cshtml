@page
@model CollectionManager.Web.Pages.Colecoes.IndexModel

@{
    ViewData["Title"] = "Coleções";
}

<div class="page-header">
    <div>
        <h1>Minhas Coleções</h1>
        <p class="page-subtitle">
            Escolha uma coleção para visualizar e gerenciar seus itens.
        </p>
    </div>
</div>

<div class="collections-grid">

    <a asp-page="/Controles/Index"
       class="collection-card collection-card-link">

        <div class="collection-card-icon">
            🎮
        </div>

        <div class="collection-card-content">
            <h2>Controles</h2>

            <p>
                Gerencie seus controles e edições especiais.
            </p>

            <span class="collection-card-action">
                Ver coleção →
            </span>
        </div>

    </a>


    <a asp-page="/Jogos/Index"
       class="collection-card collection-card-link">

        <div class="collection-card-icon">
            💿
        </div>

        <div class="collection-card-content">
            <h2>Jogos</h2>

            <p>
                Organize sua coleção de jogos por plataforma e franquia.
            </p>

            <span class="collection-card-action">
                Ver coleção →
            </span>
        </div>

    </a>


    <a asp-page="/Videogames/Index"
       class="collection-card collection-card-link">

        <div class="collection-card-icon">
            🕹️
        </div>

        <div class="collection-card-content">
            <h2>Consoles</h2>

            <p>
                Visualize e gerencie seus consoles e videogames.
            </p>

            <span class="collection-card-action">
                Ver coleção →
            </span>
        </div>

    </a>


    <a asp-page="/Leituras/Index"
       class="collection-card collection-card-link">

        <div class="collection-card-icon">
            📚
        </div>

        <div class="collection-card-content">
            <h2>Leituras</h2>

            <p>
                Organize seus mangás, quadrinhos e livros.
            </p>

            <span class="collection-card-action">
                Ver coleção →
            </span>
        </div>

    </a>

</div>