@page
@model CollectionManager.Web.Pages.Franquias.EditModel

<h1>Editar Franquia</h1>

<form method="post">

<input type="hidden" asp-for="Franquia.Id" />

<div class="mb-3">
    <label asp-for="Franquia.Nome" class="form-label"></label>

    <input asp-for="Franquia.Nome" class="form-control" />
</div>

    <button type="submit" class="btn btn-primary">
        Salvar
    </button>

    <a asp-page="Index" class="btn btn-secondary">
        Cancelar
    </a>

    <button type="submit"
            asp-page-handler="Delete"
            class="btn btn-danger">
        Excluir
    </button>

</form>