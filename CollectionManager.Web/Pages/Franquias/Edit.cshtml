@page
@model CollectionManager.Web.Pages.Franquias.EditModel

@{
    ViewData["Title"] = "Editar Franquia";
}

<div class="form-page-header">
    <a asp-page="Index" class="form-back-link">
        ← Voltar para Franquias
    </a>

    <h1>Editar Franquia</h1>

    <p class="form-page-subtitle">
        Cadastre uma franquia para organizar os itens da sua coleção.
    </p>
</div>

<form method="post" class="form-card form-card-small">

    <input type="hidden" asp-for="Franquia.Id" />

    <section class="form-section">
        <div class="form-section-title">
            Informações
        </div>

        <div class="form-grid form-grid-single">
            <div class="form-group">
                <label asp-for="Franquia.Nome" class="form-label">
                    Nome
                </label>

                <input asp-for="Franquia.Nome"
                       class="form-control"
                       placeholder="Ex.: God of War" />
            </div>
        </div>
    </section>

    <div class="form-actions">

        <button type="submit"
                asp-page-handler="Delete"
                class="btn btn-danger">
            Excluir
        </button>

        <a asp-page="Index" class="btn btn-outline-secondary">
            Cancelar
        </a>

        <button type="submit" class="btn btn-primary">
            Salvar
        </button>
    </div>

</form>