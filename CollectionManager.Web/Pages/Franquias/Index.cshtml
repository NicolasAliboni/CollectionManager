@page
@model CollectionManager.Web.Pages.Franquias.IndexModel

@{
    ViewData["Title"] = "Franquias";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1>Franquias</h1>
        <p class="page-subtitle">
            Gerencie as franquias utilizadas nas coleções.
        </p>
    </div>

    <a asp-page="Create" class="btn btn-primary">
        + Adicionar Franquia
    </a>
</div>

<div class="table-card">
    <div class="table-responsive">
        <table class="table collection-table align-middle">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var franquia in Model.Franquias)
                {
                    <tr>
                        <td>
                            <strong>@franquia.Nome</strong>
                        </td>

                        <td class="text-end">
                            <a asp-page="Edit"
                               asp-route-id="@franquia.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Editar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>