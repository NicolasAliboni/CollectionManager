@page
@model CollectionManager.Web.Pages.Jogos.IndexModel

<h1>Jogos</h1>

<a asp-page="Create" class="btn btn-primary mb-3">
    Adicionar Jogo
</a>

<table class="table">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Franquia</th>
            <th>Data Lançmento</th>
            <th>Plataforma</th>
            <th>Status</th>
            <th>Desenvolvedora</th>
            <th>Estado</th>
            <th>Valor</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var jogo in Model.Jogos)
        {
            <tr>
                <td>@jogo.Item.Nome</td>
                <td>@(jogo.Item.Franquia?.Nome ?? "-")</td>
                <td>@jogo.Item.DataLancamento</td>
                <td>@jogo.Plataforma.Nome</td>
                <td>@jogo.Status.Nome</td>
                <td>@jogo.Marca.Nome</td>
                <td>@jogo.Item.Estado.Nome</td>
                <td>@jogo.Item.ValorAquisicao</td>
                <td>
                    <a asp-page="Edit"
                       asp-route-id="@jogo.ItemId"
                       class="btn btn-sm btn-secondary">
                        Editar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>